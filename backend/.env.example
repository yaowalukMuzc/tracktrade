# TrackTrade backend settings (read by app/core/config.py).
# Copy to backend/.env for local runs; docker-compose passes these as env vars.

# dev | test | prod  (prod refuses the default JWT_SECRET and hides /docs)
ENV=dev
DATABASE_URL=postgresql+asyncpg://tracktrade:tracktrade@localhost:5432/tracktrade
REDIS_URL=redis://localhost:6379/0

# >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Grace for replaying the just-rotated refresh token (aborted refresh response)
REFRESH_REUSE_GRACE_SEC=30

# Comma-separated list of allowed browser origins (credentials enabled for the refresh cookie)
CORS_ORIGINS=http://localhost:5173
# true behind HTTPS (prod); false for http://localhost
COOKIE_SECURE=false
# Requests per window per client IP + route on /api/v1/auth/*  (N/sec | N/min | N/hour)
RATE_LIMIT_AUTH=10/min
LOG_LEVEL=INFO
