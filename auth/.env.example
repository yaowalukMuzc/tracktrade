# TrackTrade auth service (Better Auth). Copy to auth/.env for `npm run dev`;
# docker compose passes these as env vars instead.
ENV=dev
PORT=3000
# Same database as the backend (Alembic owns the schema — run `alembic upgrade head` first).
DATABASE_URL=postgresql://tracktrade:tracktrade@localhost:5432/tracktrade
# >= 32 chars; signs cookies and encrypts the JWT private key. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Public origin of the web app (browser reaches /api/auth through it); reset links point here.
BETTER_AUTH_URL=http://localhost:5179
TRUSTED_ORIGINS=http://localhost:5179,http://localhost:8080
COOKIE_SECURE=false
# Must match the backend's JWT_ISSUER / JWT_AUDIENCE
JWT_ISSUER=tracktrade-auth
JWT_AUDIENCE=tracktrade-api
# sign-in / sign-up / password reset, per client IP ("off" disables)
RATE_LIMIT_AUTH=10/min
# Mailpit in dev (docker compose service `mailpit`, inbox UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TrackTrade <no-reply@tracktrade.local>
