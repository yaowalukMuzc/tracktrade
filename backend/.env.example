# TrackTrade backend settings (read by app/core/config.py).
# Copy to backend/.env for local runs; docker-compose passes these as env vars.

# dev | test | prod  (prod hides /docs)
ENV=dev
DATABASE_URL=postgresql+asyncpg://tracktrade:tracktrade@localhost:5432/tracktrade
REDIS_URL=redis://localhost:6379/0

# Better Auth service (auth/): JWTs are verified with its public keys.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=tracktrade-auth
JWT_AUDIENCE=tracktrade-api
JWKS_CACHE_SEC=300

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5179
LOG_LEVEL=INFO

# Frontend origin (the cTrader OAuth callback redirects the browser back here)
APP_URL=http://localhost:5179

# Broker ingest (Phase 4)
RATE_LIMIT_INGEST=120/min
MATCH_TOLERANCE_SL=0.3
MT5_EA_DIR=../connectors/mt5-ea

# cTrader Open API — linking is disabled while any of these is empty.
# FERNET_KEY encrypts OAuth tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:5179/api/v1/connections/ctrader/callback
