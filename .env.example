# docker compose settings — copy to .env to override the defaults in docker-compose.yml.
# Backend-only runs (without docker) use backend/.env.example instead.

ENV=dev
POSTGRES_USER=tracktrade
POSTGRES_PASSWORD=tracktrade
POSTGRES_DB=tracktrade

# >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# true behind HTTPS (prod)
COOKIE_SECURE=false
RATE_LIMIT_AUTH=10/min
LOG_LEVEL=INFO

# Host ports
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
