# docker compose settings — copy to .env to override the defaults in docker-compose.yml.
# Backend-only runs (without docker) use backend/.env.example instead.

ENV=dev
POSTGRES_USER=tracktrade
POSTGRES_PASSWORD=tracktrade
POSTGRES_DB=tracktrade

# Better Auth (auth service). Secret >= 32 chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Public origin of the web app: reset-password links point here
PUBLIC_URL=http://localhost:8080
# Origins allowed to call /api/auth (and the API's CORS list)
CORS_ORIGINS=http://localhost:8080,http://localhost:5178
# true behind HTTPS (prod)
COOKIE_SECURE=false
# sign-in / sign-up / password reset, per client IP
RATE_LIMIT_AUTH=10/min
JWT_ISSUER=tracktrade-auth
JWT_AUDIENCE=tracktrade-api
LOG_LEVEL=INFO

# Email (reset password). Dev default = the mailpit container.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=TrackTrade <no-reply@tracktrade.local>

# Host ports
WEB_PORT=8080
API_PORT=8000
AUTH_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
POSTGRES_PORT=5432
REDIS_PORT=6379
